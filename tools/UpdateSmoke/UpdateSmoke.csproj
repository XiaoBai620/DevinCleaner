<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>DevinCleaner</AssemblyName>
    <Product>DevinCleaner</Product>
    <Version>0.0.0</Version>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <RollForward>LatestMajor</RollForward>
    <DebugType>embedded</DebugType>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="../../src/DevinCleaner/UpdateChecker.cs" Link="UpdateChecker.cs" />
    <Compile Include="../../src/DevinCleaner/AppUpdater.cs" Link="AppUpdater.cs" />
    <Compile Include="../../src/DevinCleaner/UpdateInstaller.cs" Link="UpdateInstaller.cs" />
    <Compile Include="../../src/DevinCleaner/Engine/UpdatePaths.cs" Link="UpdatePaths.cs" />
  </ItemGroup>
</Project>
